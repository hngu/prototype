# Copy to .env at the repo root (.env is gitignored).
#
# OpenSky moved to OAuth2 client-credentials in March 2026. Register at
# opensky-network.org and create an API client to get these. The secret must
# stay server-side — anything holding it can spend the daily credit budget.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Poll cadence. 90000 => 960 polls/day => 3840 of the 4000 daily credits.
# Feeding data to OpenSky raises the budget to 8000, which allows ~45000.
POLL_INTERVAL_MS=90000

# Raise to 8000 if the account has the data-feeder budget.
OPENSKY_CREDIT_BUDGET=4000

# OpenSky poller listen port (see plans/flight-tracker.md).
PORT=3001

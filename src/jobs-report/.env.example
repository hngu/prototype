# Copy to .env and fill in. .env is gitignored; never commit real values.

# Contact email sent in the User-Agent of every request (required).
CONTACT_EMAIL=you@example.com

# Adzuna (free key: https://developer.adzuna.com/). Milestone 4.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJOBS (free key: https://developer.usajobs.gov/apirequest/). Milestone 4.
# Its User-Agent must be the email the key was requested with (CONTACT_EMAIL).
USAJOBS_API_KEY=

# The Muse (registration required beyond testing). Milestone 4.
THEMUSE_API_KEY=

# JSearch on RapidAPI (paid, off by default; discovery only).
JSEARCH_RAPIDAPI_KEY=

# Cloudflare R2 for the cloud schedule. Milestone 6.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

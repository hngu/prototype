# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=https://adonis.app

# Session
SESSION_DRIVER=cookie

# Database (PostgreSQL)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB_NAME=prototype

# Redis Cluster (master seeds; replicas are discovered)
REDIS_NODES=127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
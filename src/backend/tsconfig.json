{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    // rootDir must contain every input file, and ../shared is an input.
    // Consequence: emitted output is dist/backend/src/*.js, hence the `start`
    // script path. See src/shared/flight.ts for why the types live outside.
    "rootDir": "..",
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src", "../shared"],
  "exclude": ["dist"]
}

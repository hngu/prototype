---
/**
 * Sets the theme before first paint.
 *
 * `is:inline` is mandatory here: without it Astro bundles and defers the script,
 * which reintroduces exactly the flash of wrong theme this exists to prevent.
 * This must stay the first thing in <head>, before any stylesheet.
 */
---

<script is:inline>
  ;(() => {
    try {
      const stored = localStorage.getItem('theme')
      const theme =
        stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      document.documentElement.dataset.theme = theme
    } catch {
      document.documentElement.dataset.theme = 'light'
    }
  })()
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <div class="container-page section notfound">
    <p class="notfound__code">404</p>
    <h1>That page does not exist.</h1>
    <p class="notfound__body">
      The link may be out of date, or the lesson may have been renamed. The course list is the
      quickest way back.
    </p>
    <div class="notfound__actions">
      <a class="btn" href="/courses">Browse courses</a>
      <a class="link" href="/">Go home</a>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    max-width: 46ch;
  }

  .notfound__code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-brand-500);
    letter-spacing: 0.1em;
  }

  .notfound h1 {
    margin-top: 0.75rem;
    font-size: var(--text-3xl);
    font-weight: 680;
  }

  .notfound__body {
    margin-top: 1rem;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .notfound__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .btn {
    padding: 0.7rem 1.35rem;
    border-radius: 0.55rem;
    background: var(--color-brand-500);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 620;
    text-decoration: none;
  }
  .btn:hover {
    background: var(--color-brand-600);
  }

  .link {
    font-size: var(--text-sm);
    font-weight: 560;
    color: var(--color-muted);
    text-decoration: none;
  }
  .link:hover {
    color: var(--color-content);
  }
</style>
